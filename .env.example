# Copy to .env (gitignored) and fill in. Generate certificates first: scripts/dev-certs.sh

# Database container init (only applied when the sekondo-db-data volume is first created)
POSTGRES_USER=sekondo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sekondo

# Host-side dev tools (cargo, sqlx, tests): verify-full against the mkcert root CA.
# Replace the path with the output of `mkcert -CAROOT` + /rootCA.pem (or use ./certs/rootCA.pem).
# Inside Compose the app uses db:5432 and /certs/rootCA.pem instead.
# NOTE: use an absolute sslrootcert path: cargo tests run from the crate directory.
DATABASE_URL=postgres://sekondo:change-me@localhost:5432/sekondo?sslmode=verify-full&sslrootcert=/absolute/path/to/certs/rootCA.pem

# Listener (inside the container). HTTPS only.
BIND_ADDR=0.0.0.0:8443
TLS_CERT_PATH=./certs/dev.pem
TLS_KEY_PATH=./certs/dev-key.pem
# Optional extra root CA trusted for outbound HTTPS (e.g. for eve-stub); adds trust, never disables checks.
TLS_EXTRA_CA_PATH=./certs/rootCA.pem

# Must be https://. Callback URL is {PUBLIC_BASE_URL}/auth/callback
PUBLIC_BASE_URL=https://localhost:8443

# Register an application at https://developers.eveonline.com with the callback above.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_SSO_BASE_URL=https://login.eveonline.com
ESI_BASE_URL=https://esi.evetech.net

# base64 of 32 random bytes: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Directory with the vendored htmx, Pico.css and app.js (defaults to crates/sekondo/static)
STATIC_DIR=./crates/sekondo/static
